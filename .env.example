# Variables are read from the shell environment; server.py does not parse this file.
PORT=8787
SHURSH_DB=data/shursh.sqlite3
SHURSH_DEMO=1
# Set to 1 only when the app is actually served over HTTPS behind a trusted proxy.
SHURSH_HTTPS=0

# Cloud WSGI mode (configure only in server environment; never commit credentials).
# SHURSH_DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SHURSH_RATE_SECRET=
# SHURSH_AUTH_REDIRECT_URL=
# Allowlisted administrator account email(s), comma-separated; empty disables admin inbox.
# SHURSH_ADMIN_EMAILS=

# Fail-closed Preview-only Staging guard (do NOT set on Production).
# SHURSH_ENV=staging
# SHURSH_EXPECTED_SUPABASE_REF=vwhzhbsaspbelkvnjjho
# SHURSH_DATABASE_URL must use a Staging pooler user suffix .vwhzhbsaspbelkvnjjho and sslmode=require.
# SUPABASE_URL=https://vwhzhbsaspbelkvnjjho.supabase.co
# All secrets must be separate from Production and stored only in Vercel Preview variables.
